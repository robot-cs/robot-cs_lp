---
import { Image } from "astro:assets";
import { icon, library } from "@fortawesome/fontawesome-svg-core";
import { faXTwitter } from "@fortawesome/free-brands-svg-icons";

library.add(faXTwitter);
const XIcon = icon(faXTwitter);
import logoIcon from "../../assets/my-icon.webp";
import { useLink } from "../../utils/link";
---

<header class="header">
  <a href={useLink("")} class="header-title">
    <Image src={logoIcon} quality={70} alt="my-icon" class="header-logo" />
    <h1>RobotCreators</h1>
  </a>
  <nav class="nav PC">
    <a href={useLink("/#about", false)} id="nav-about">About</a>
    <a href={useLink("works")} id="nav-works">Works</a>
    <a href={useLink("blog")} id="nav-news">Blog</a>
    <a href={useLink("/#contact", false)} id="nav-contact">Contact</a>
    <a
      id="nav-twitter"
      href="https://twitter.com/Robot_CS"
      target="_blank"
      aria-hidden="true"
      rel="noopener noreferrer"
      ><span set:html={XIcon.html} />
    </a>
  </nav>
  <div class="ham_and_acc SP">
    <input type="checkbox" id="ham_check" />
    <label for="ham_check" class="hamburger">
      <div class="line" id="line_1"></div>
      <div class="line" id="line_2"></div>
      <div class="line" id="line_3"></div>
    </label>
    <nav class="accordion">
      <div>
        <a href={useLink("/#about", false)} id="nav-about" class="acc_a"
          >About</a
        >
        <hr />
        <a href={useLink("works")} id="nav-works" class="acc_a">Works</a>
        <hr />
        <a href={useLink("blog")} id="nav-news" class="acc_a">Blog</a>
        <hr />
        <a href={useLink("/#contact", false)} id="nav-contact" class="acc_a"
          >Contact</a
        >
        <hr />
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    height: 60px;
    background: var(--background);
    color: var(--black);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 8px 0 32px;

    a {
      color: inherit;
      text-decoration: inherit;
    }
    a:hover {
      color: indigo;
    }
    .header-title {
      display: flex;
      gap: 8px;
      align-items: center;

      .header-title h1 {
        font-size: 40px;
      }
      .header-logo {
        width: 32px;
        height: 32px;
      }
    }
    .nav {
      font-size: 18px;
      a {
        margin: 0 8px;
      }
    }
    .ham_and_acc {
      & #ham_check {
        display: none;
      }
      & .hamburger {
        position: relative;
        display: block;
        width: 60px;
        height: 60px;
        & .line {
          position: absolute;
          width: 50px;
          height: 2px;
          left: 5px;
          background: var(--black);
          transition:
            transform 0.5s ease,
            opacity 0.5s ease;
        }
        & #line_1 {
          top: 15px;
        }
        & #line_2 {
          top: 30px;
        }
        & #line_3 {
          top: 45px;
        }
      }
      & .accordion {
	z-index:-1;
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.6s ease;
        background: var(--background);
        color: var(--black);
        position: absolute;
        left: 0;
        top: auto;
        width: 100dvw;
        overflow: hidden;
        padding-bottom: 8px;
        border-radius: 4px;
        & > * {
          min-height: 0;
          overflow: hidden;
        }
        & .acc_a {
          display: block;
          font-size: 20px;
          text-align: right;
          padding: 8px 32px 8px 0;
        }
      }
    }
    .ham_and_acc:has(input:checked) {
      & .hamburger {
        & #line_1 {
          transform: translateY(15px) rotate(45deg);
        }
        & #line_3 {
          transform: translateY(-15px) rotate(-45deg);
        }
        & #line_2 {
          opacity: 0;
        }
      }
      & .accordion {
        grid-template-rows: 1fr;
	z-index:1000;
      }
    }
  }
  @media screen and (max-width: 720px) {
    .PC {
      display: none;
    }
    .SP {
      display: block;
    }
  }
  @media screen and (min-width: 720px) {
    .SP {
      display: none;
    }
  }
</style>
